<Window x:Class="ProcessMonitor.Views.MonitoredProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Monitored Process"
        Width="460" Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B_BG}"
        Foreground="{StaticResource B_Text}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Process Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Process name:"
                   Foreground="{StaticResource B_Dim}" VerticalAlignment="Center"
                   Margin="0,0,0,12"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtName"
                   Style="{StaticResource DarkTextBox}"
                   Height="26" Margin="0,0,0,12"/>

        <!-- CPU Threshold -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU threshold (%):"
                   Foreground="{StaticResource B_Dim}" VerticalAlignment="Center"
                   Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="TxtCpu" Width="90" Height="26"
                     Style="{StaticResource DarkTextBox}"
                     Foreground="{StaticResource B_Accent}" Text="80"/>
            <TextBlock Text="  1 – 100" VerticalAlignment="Center"
                       Foreground="{StaticResource B_Dim}" FontSize="11" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Memory Threshold -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory threshold (MB):"
                   Foreground="{StaticResource B_Dim}" VerticalAlignment="Center"
                   Margin="0,0,0,12"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="TxtMem" Width="90" Height="26"
                     Style="{StaticResource DarkTextBox}"
                     Foreground="{StaticResource B_Accent2}" Text="500"/>
            <TextBlock x:Name="TbMemHint" Text="  1 – 65536" VerticalAlignment="Center"
                       Foreground="{StaticResource B_Dim}" FontSize="11" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Monitoring Enabled -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Monitoring enabled:"
                   Foreground="{StaticResource B_Dim}" VerticalAlignment="Center"
                   Margin="0,0,0,12"/>
        <CheckBox  Grid.Row="3" Grid.Column="1" x:Name="ChkEnabled"
                   IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,12"
                   Foreground="{StaticResource B_Accent}">
            <CheckBox.Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Bd" Width="16" Height="16"
                                            Background="{StaticResource B_Panel2}"
                                            BorderBrush="{StaticResource B_Border}"
                                            BorderThickness="1" CornerRadius="2">
                                        <TextBlock x:Name="Chk" Text="✔" FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource B_Accent}"
                                                   Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chk" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                Value="{StaticResource B_Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </CheckBox.Style>
        </CheckBox>

        <!-- Error label -->
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="TbError" Text="" Foreground="{StaticResource B_Accent3}"
                   FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="Save" Width="100" Height="32" Margin="0,0,12,0"
                    Style="{StaticResource AccentBtn}"
                    Background="{StaticResource B_Accent}"
                    Foreground="{StaticResource B_BG}"
                    BorderBrush="{StaticResource B_Accent}"
                    FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="100" Height="32"
                    Style="{StaticResource AccentBtn}"
                    Foreground="{StaticResource B_Text}"
                    BorderBrush="{StaticResource B_Border}"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
