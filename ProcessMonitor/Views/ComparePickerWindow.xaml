<Window x:Class="ProcessMonitor.Views.ComparePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare Snapshots"
        Width="440" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B_Panel}"
        Foreground="{StaticResource B_Text}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ComboBox x:Name="CmbA" Grid.Row="0"
                  Style="{StaticResource DarkCombo}" Height="28"/>

        <ComboBox x:Name="CmbB" Grid.Row="2"
                  Style="{StaticResource DarkCombo}" Height="28"/>

        <Button Grid.Row="4" Content="Compare" Width="110" Height="30"
                HorizontalAlignment="Left"
                Style="{StaticResource AccentBtn}"
                Background="{StaticResource B_Accent}"
                Foreground="{StaticResource B_BG}"
                BorderBrush="{StaticResource B_Accent}"
                FontWeight="Bold"
                Click="BtnCompare_Click"/>
    </Grid>
</Window>
