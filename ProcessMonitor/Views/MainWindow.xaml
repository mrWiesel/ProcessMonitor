<Window x:Class="ProcessMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ProcessMonitor.Converters"
        xmlns:models="clr-namespace:ProcessMonitor.Models"
        mc:Ignorable="d"
        d:DesignWidth="1220"
        Title="⬡  ProcessMonitor  —  Windows System Analyser"
        Width="1220" Height="879" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B_BG}"
        Foreground="{StaticResource B_Text}">

    <Window.Resources>
        <conv:CpuToColorConverter       x:Key="CpuColor"/>
        <conv:RamToColorConverter       x:Key="RamColor"/>
        <conv:StatusToColorConverter    x:Key="StatusColor"/>
        <conv:BoolToYesNoConverter      x:Key="BoolYesNo"/>
        <conv:BoolToAccentDimConverter  x:Key="BoolAccentDim"/>
        <conv:AlertTypeToColorConverter x:Key="AlertTypeColor"/>
        <conv:TimestampConverter        x:Key="Timestamp"/>
        <conv:TimestampShortConverter   x:Key="TimestampShort"/>
        <conv:FloatPctConverter         x:Key="FloatPct"/>
        <conv:FloatMbConverter          x:Key="FloatMb"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- DarkRadio defined here so XAML Designer can resolve it -->
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground"  Value="{StaticResource B_Dim}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{StaticResource B_Panel2}"
                                BorderBrush="{StaticResource B_Border}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource B_Sel}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource B_Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource B_Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#1A00C896"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource B_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="86"/>
            <RowDefinition Height="108"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ROW 0 — TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource B_Panel}">
            <Grid Margin="16,0">
                <TextBlock Text="⬡  PROCESS MONITOR"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource B_Accent}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ROW 1 — STAT CARDS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8,0,8">
            <Border Width="196" Margin="0,0,14,0"
                    Background="{StaticResource B_Panel}"
                    BorderBrush="{StaticResource B_Border}" BorderThickness="1">
                <Grid>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource B_Accent}"/>
                    <StackPanel Margin="16,10,10,10">
                        <TextBlock Text="CPU Usage" FontSize="11" Foreground="{StaticResource B_Dim}"/>
                        <TextBlock x:Name="TbCpuVal" Text="–" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource B_Accent}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Width="196" Margin="0,0,14,0"
                    Background="{StaticResource B_Panel}"
                    BorderBrush="{StaticResource B_Border}" BorderThickness="1">
                <Grid>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource B_Accent2}"/>
                    <StackPanel Margin="16,10,10,10">
                        <TextBlock Text="RAM Usage" FontSize="11" Foreground="{StaticResource B_Dim}"/>
                        <TextBlock x:Name="TbRamVal" Text="–" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource B_Accent2}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Width="196"
                    Background="{StaticResource B_Panel}"
                    BorderBrush="{StaticResource B_Border}" BorderThickness="1">
                <Grid>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource B_Accent3}"/>
                    <StackPanel Margin="16,10,10,10">
                        <TextBlock Text="Processes" FontSize="11" Foreground="{StaticResource B_Dim}"/>
                        <TextBlock x:Name="TbProcsVal" Text="–" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource B_Accent3}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ROW 2 — GRAPH CANVAS -->
        <Border Grid.Row="2" Background="{StaticResource B_Panel}">
            <Canvas x:Name="GraphCanvas" ClipToBounds="True"/>
        </Border>

        <!-- ROW 3 — MAIN TABS -->
        <TabControl x:Name="MainTabs" Grid.Row="3"
                    Background="{StaticResource B_BG}"
                    BorderBrush="{StaticResource B_Border}"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background"  Value="{StaticResource B_Panel}"/>
                    <Setter Property="Foreground"  Value="{StaticResource B_Dim}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource B_Border}"/>
                    <Setter Property="FontFamily"  Value="Segoe UI"/>
                    <Setter Property="FontSize"    Value="13"/>
                    <Setter Property="FontWeight"  Value="SemiBold"/>
                    <Setter Property="Padding"     Value="14,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,0,0,2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource B_BG}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                        <Setter Property="Foreground" Value="{StaticResource B_Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A00C896"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ── Tab 1: Processes ─────────────────────────────────── -->
            <TabItem Header="Processes" x:Name="TabProcesses">
                <Grid Background="{StaticResource B_BG}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B_BG}"
                            BorderBrush="{StaticResource B_Border}" BorderThickness="0,0,0,1">
                        <WrapPanel Margin="8,7" Orientation="Horizontal">
                            <Grid Width="260" Height="26" Margin="0,0,8,0">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource DarkTextBox}"
                                         TextChanged="SearchBox_TextChanged"
                                         Panel.ZIndex="1"/>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="🔍  Filter by name or PID…"
                                           Foreground="{StaticResource B_Dim}"
                                           FontSize="12" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Panel.ZIndex="0"/>
                            </Grid>
                            <Button Content="↻  Refresh"  Margin="0,0,6,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent}"
                                    BorderBrush="{StaticResource B_Accent}"
                                    Click="BtnRefreshProcs_Click"/>
                            <Button Content="📋  Details" Margin="0,0,6,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent2}"
                                    BorderBrush="{StaticResource B_Accent2}"
                                    Click="BtnDetails_Click"/>
                            <Button Content="✕  Kill"    Margin="0,0,6,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent3}"
                                    BorderBrush="{StaticResource B_Accent3}"
                                    Click="BtnKill_Click"/>
                            <Button Content="▶  Start"   Margin="0,0,18,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent}"
                                    BorderBrush="{StaticResource B_Accent}"
                                    Click="BtnStart_Click"/>
                            <TextBlock Text="Per page:" VerticalAlignment="Center"
                                       Foreground="{StaticResource B_Dim}"
                                       Margin="0,0,8,0" FontSize="12"/>
                            <RadioButton x:Name="Rp50"  Content="50"  GroupName="PageSize" Tag="50"
                                         Margin="0,0,6,0" VerticalAlignment="Center"
                                         Checked="RbPageSize_Checked" Style="{StaticResource DarkRadio}"/>
                            <RadioButton x:Name="Rp100" Content="100" GroupName="PageSize" Tag="100"
                                         Margin="0,0,6,0" VerticalAlignment="Center" IsChecked="True"
                                         Checked="RbPageSize_Checked" Style="{StaticResource DarkRadio}"/>
                            <RadioButton x:Name="Rp200" Content="200" GroupName="PageSize" Tag="200"
                                         Margin="0,0,18,0" VerticalAlignment="Center"
                                         Checked="RbPageSize_Checked" Style="{StaticResource DarkRadio}"/>
                            <!-- CPU filter -->
                            <TextBlock Text="CPU≥" VerticalAlignment="Center"
                                       Foreground="{StaticResource B_Dim}" FontSize="12"
                                       Margin="0,0,4,0"/>
                            <TextBox x:Name="TbCpuMin" Width="48" Height="24"
                                     Style="{StaticResource DarkTextBox}"
                                     Text="0" TextAlignment="Right"
                                     Margin="0,0,4,0"
                                     TextChanged="FilterNumeric_Changed"/>
                            <TextBlock Text="%" VerticalAlignment="Center"
                                       Foreground="{StaticResource B_Dim}" FontSize="12"
                                       Margin="0,0,14,0"/>
                            <!-- RAM filter -->
                            <TextBlock Text="RAM≥" VerticalAlignment="Center"
                                       Foreground="{StaticResource B_Dim}" FontSize="12"
                                       Margin="0,0,4,0"/>
                            <TextBox x:Name="TbRamMin" Width="58" Height="24"
                                     Style="{StaticResource DarkTextBox}"
                                     Text="0" TextAlignment="Right"
                                     Margin="0,0,4,0"
                                     TextChanged="FilterNumeric_Changed"/>
                            <TextBlock Text="MB" VerticalAlignment="Center"
                                       Foreground="{StaticResource B_Dim}" FontSize="12"/>
                        </WrapPanel>
                    </Border>

                    <ListView x:Name="ProcList" Grid.Row="1"
                              Style="{StaticResource DarkListView}"
                              ItemContainerStyle="{StaticResource DarkListViewItem}"
                              MouseDoubleClick="ProcList_DoubleClick"
                              GridViewColumnHeader.Click="ProcListHeader_Click" Margin="0,10,0,0" Grid.RowSpan="2" Height="462" VerticalAlignment="Top">
                        <ListView.ContextMenu>
                            <ContextMenu Background="{StaticResource B_Panel2}"
                                         Foreground="{StaticResource B_Text}"
                                         BorderBrush="{StaticResource B_Border}">
                                <MenuItem Header="📋  View Details"
                                          Click="BtnDetails_Click"
                                          Background="{StaticResource B_Panel2}"
                                          Foreground="{StaticResource B_Text}"/>
                                <MenuItem Header="✕  Kill Process"
                                          Click="BtnKill_Click"
                                          Background="{StaticResource B_Panel2}"
                                          Foreground="{StaticResource B_Accent3}"/>
                                <MenuItem Header="➕  Add to Monitoring"
                                          Click="MenuAddToMonitor_Click"
                                          Background="{StaticResource B_Panel2}"
                                          Foreground="{StaticResource B_Accent}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                                <GridViewColumn Header="PID"      Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Pid}" TextAlignment="Right"
                                                       Foreground="{StaticResource B_Dim}"
                                                       HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name"     Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CPU %"    Width="72">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuUsage, StringFormat=0.00}"
                                                       TextAlignment="Right"
                                                       HorizontalAlignment="Stretch"
                                                       Foreground="{Binding CpuUsage,
                                                           Converter={StaticResource CpuColor}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="RAM MB"   Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MemoryUsage, StringFormat=0.0}"
                                                       TextAlignment="Right"
                                                       HorizontalAlignment="Stretch"
                                                       Foreground="{Binding MemoryUsage,
                                                           Converter={StaticResource RamColor}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Threads"  Width="68">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ThreadCount}"
                                                       TextAlignment="Right"
                                                       HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Handles"  Width="72">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HandleCount}"
                                                       TextAlignment="Right"
                                                       HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Priority" Width="82">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Priority}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status"   Width="95">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Status,
                                                           Converter={StaticResource StatusColor}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Started"  Width="148">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartTime}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource B_Dim}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2" Background="{StaticResource B_Panel}"
                            BorderBrush="{StaticResource B_Border}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                            <Button Content="◀ Prev" Width="80" Height="22" Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Text}"
                                    BorderBrush="{StaticResource B_Border}"
                                    Click="BtnPrev_Click"/>
                            <TextBlock x:Name="TbPage" Text="Page 1 / 1"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource B_Dim}" FontSize="12"/>
                            <Button Content="Next ▶" Width="80" Height="22"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Text}"
                                    BorderBrush="{StaticResource B_Border}"
                                    Click="BtnNext_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Tab 2: Monitoring ────────────────────────────────── -->
            <TabItem Header="Monitoring" x:Name="TabMonitoring">
                <Grid Background="{StaticResource B_BG}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="0.417"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B_Panel}"
                            BorderBrush="{StaticResource B_Border}" BorderThickness="0,0,0,1" Grid.RowSpan="3">
                        <WrapPanel Margin="8,8" Orientation="Horizontal">
                            <Button Content="➕  Add"    Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent}"
                                    BorderBrush="{StaticResource B_Accent}"
                                    Click="BtnMonAdd_Click"/>
                            <Button Content="✎  Edit"   Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent2}"
                                    BorderBrush="{StaticResource B_Accent2}"
                                    Click="BtnMonEdit_Click"/>
                            <Button Content="✕  Delete" Margin="0,0,16,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent3}"
                                    BorderBrush="{StaticResource B_Accent3}"
                                    Click="BtnMonDel_Click"/>
                            <TextBlock Text="Tip: right-click any process → Add to Monitoring"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource B_Dim}"
                                       FontSize="11" FontStyle="Italic"/>
                        </WrapPanel>
                    </Border>

                    <ListView x:Name="MonList" Grid.Row="2"
                              Style="{StaticResource DarkListView}"
                              ItemContainerStyle="{StaticResource DarkListViewItem}"
                              GridViewColumnHeader.Click="MonListHeader_Click" Margin="0,4,0,0" Grid.RowSpan="2">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                                <GridViewColumn Header="ID"           Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}"
                                                       TextAlignment="Center" Width="40"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Process Name" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessName}" Width="210"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CPU Thr. %"  Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuThreshold, StringFormat=0}"
                                                       TextAlignment="Right" Width="80"
                                                       Foreground="{StaticResource B_Accent}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="RAM Thr. MB" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MemoryThreshold, StringFormat=0}"
                                                       TextAlignment="Right" Width="90"
                                                       Foreground="{StaticResource B_Accent2}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Enabled"     Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsMonitored,
                                                           Converter={StaticResource BoolYesNo}}"
                                                       TextAlignment="Center" Width="60"
                                                       Foreground="{Binding IsMonitored,
                                                           Converter={StaticResource BoolAccentDim}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Created"     Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreatedAt,
                                                           Converter={StaticResource TimestampShort}}"
                                                       Width="150" Foreground="{StaticResource B_Dim}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ── Tab 3: Alerts ───────────────────────────────────── -->
            <TabItem x:Name="TabAlerts">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Alerts"/>
                        <Border x:Name="AlertBadge" Margin="6,0,0,0"
                                Background="{StaticResource B_Accent3}"
                                CornerRadius="8" Padding="5,1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TbAlertBadge" Text="0"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{StaticResource B_BG}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B_Panel}"
                            BorderBrush="{StaticResource B_Border}" BorderThickness="0,0,0,1" HorizontalAlignment="Right" Width="1214">
                        <WrapPanel Margin="8,8" Orientation="Horizontal">
                            <TextBlock x:Name="TbAlertCount" Text="0 alerts"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{StaticResource B_Dim}" FontSize="12"/>
                            <Button Content="✔ Ack All"  Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent}"
                                    BorderBrush="{StaticResource B_Accent}"
                                    Click="BtnAckAll_Click"/>
                            <Button Content="✕ Delete"   Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent3}"
                                    BorderBrush="{StaticResource B_Accent3}"
                                    Click="BtnDelAlert_Click"/>
                            <Button Content="↻ Refresh"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent2}"
                                    BorderBrush="{StaticResource B_Accent2}"
                                    Click="BtnRefreshAlerts_Click"/>
                        </WrapPanel>
                    </Border>

                    <ListView x:Name="AlertList" Grid.Row="1"
                              Style="{StaticResource DarkListView}"
                              ItemContainerStyle="{StaticResource DarkListViewItem}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                                <GridViewColumn Header="ID"      Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}"
                                                       TextAlignment="Center" Width="40"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Process" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessName}" Width="140"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Type"    Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AlertType}" Width="80"
                                                       Foreground="{Binding AlertType,
                                                           Converter={StaticResource AlertTypeColor}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Value"   Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="TbAlertVal" Width="80"
                                                       TextAlignment="Right"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding AlertType}"
                                                             Value="{x:Static models:AlertType.HighCPU}">
                                                    <Setter TargetName="TbAlertVal" Property="Text"
                                                            Value="{Binding Value,
                                                                StringFormat={}{0:0.0}%}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlertType}"
                                                             Value="{x:Static models:AlertType.HighMemory}">
                                                    <Setter TargetName="TbAlertVal" Property="Text"
                                                            Value="{Binding Value,
                                                                StringFormat={}{0:0.0} MB}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Time"    Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Timestamp,
                                                           Converter={StaticResource Timestamp}}"
                                                       Width="150" Foreground="{StaticResource B_Dim}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Ack"     Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsAcknowledged,
                                                           Converter={StaticResource BoolYesNo}}"
                                                       TextAlignment="Center" Width="50"
                                                       Foreground="{Binding IsAcknowledged,
                                                           Converter={StaticResource BoolAccentDim}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ── Tab 4: Snapshots ─────────────────────────────────── -->
            <TabItem Header="Snapshots" x:Name="TabSnapshots">
                <Grid Background="{StaticResource B_BG}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B_Panel}"
                            BorderBrush="{StaticResource B_Border}" BorderThickness="0,0,0,1">
                        <WrapPanel Margin="8,8" Orientation="Horizontal">
                            <Button Content="Take"   Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent}"
                                    BorderBrush="{StaticResource B_Accent}"
                                    Click="BtnTakeSnap_Click"/>
                            <Button Content="Export"  Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent2}"
                                    BorderBrush="{StaticResource B_Accent2}"
                                    Click="BtnExportSnap_Click"/>
                            <Button Content="Compare" Margin="0,0,8,0"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="#D2A0FF" BorderBrush="#D2A0FF"
                                    Click="BtnCompareSnap_Click"/>
                            <Button Content="Delete"
                                    Style="{StaticResource AccentBtn}"
                                    Foreground="{StaticResource B_Accent3}"
                                    BorderBrush="{StaticResource B_Accent3}"
                                    Click="BtnDeleteSnap_Click"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="322"/>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="SnapList" Grid.Column="0"
                                  Style="{StaticResource DarkListView}"
                                  ItemContainerStyle="{StaticResource DarkListViewItem}"
                                  SelectionChanged="SnapList_SelectionChanged" Grid.ColumnSpan="2">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                                    <GridViewColumn Header="ID"     Width="42">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}"
                                                           TextAlignment="Center" Width="32"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Label"  Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Width="130"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Time"   Width="148">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Timestamp,
                                                               Converter={StaticResource Timestamp}}"
                                                           Width="138"
                                                           Foreground="{StaticResource B_Dim}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="CPU%"   Width="52">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CpuUsage, StringFormat=0.0}"
                                                           TextAlignment="Right" Width="42"
                                                           Foreground="{StaticResource B_Accent}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="#Procs" Width="52">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProcessCount}"
                                                           TextAlignment="Right" Width="42"
                                                           Foreground="{StaticResource B_Accent2}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Grid.Column="2" Width="4"
                                      HorizontalAlignment="Stretch"
                                      Background="{StaticResource B_Border}"/>

                        <TextBox x:Name="SnapDetail" Grid.Column="3"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="{StaticResource B_Panel}"
                                 Foreground="{StaticResource B_Text}"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="12"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ROW 4 — STATUS BAR -->
        <Border Grid.Row="4" Background="{StaticResource B_Panel}"
                BorderBrush="{StaticResource B_Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TbStatus" Text="  Initialising…"
                       Foreground="{StaticResource B_Dim}"
                       FontSize="11" VerticalAlignment="Center"
                       Padding="12,0"/>
        </Border>

        <!-- Toast overlay -->
        <Border x:Name="ToastBorder" Grid.Row="0" Grid.RowSpan="5"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,140,0,0"
                Background="#E01E252E"
                BorderBrush="{StaticResource B_Accent3}" BorderThickness="1"
                CornerRadius="4" Padding="20,10"
                Visibility="Collapsed">
            <TextBlock x:Name="TbToast" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource B_Accent3}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
