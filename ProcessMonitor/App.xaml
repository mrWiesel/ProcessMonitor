<Application x:Class="ProcessMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Palette ─────────────────────────────────────────────── -->
            <Color x:Key="C_BG">#0D1117</Color>
            <Color x:Key="C_Panel">#16181B</Color>
            <Color x:Key="C_Panel2">#1E252E</Color>
            <Color x:Key="C_Border">#30363D</Color>
            <Color x:Key="C_Accent">#00C896</Color>
            <Color x:Key="C_Accent2">#58A6FF</Color>
            <Color x:Key="C_Accent3">#FF794D</Color>
            <Color x:Key="C_Text">#E6EDF3</Color>
            <Color x:Key="C_Dim">#6E7681</Color>
            <Color x:Key="C_RowAlt">#12161C</Color>
            <Color x:Key="C_Sel">#005846</Color>

            <SolidColorBrush x:Key="B_BG"     Color="{StaticResource C_BG}"/>
            <SolidColorBrush x:Key="B_Panel"   Color="{StaticResource C_Panel}"/>
            <SolidColorBrush x:Key="B_Panel2"  Color="{StaticResource C_Panel2}"/>
            <SolidColorBrush x:Key="B_Border"  Color="{StaticResource C_Border}"/>
            <SolidColorBrush x:Key="B_Accent"  Color="{StaticResource C_Accent}"/>
            <SolidColorBrush x:Key="B_Accent2" Color="{StaticResource C_Accent2}"/>
            <SolidColorBrush x:Key="B_Accent3" Color="{StaticResource C_Accent3}"/>
            <SolidColorBrush x:Key="B_Text"    Color="{StaticResource C_Text}"/>
            <SolidColorBrush x:Key="B_Dim"     Color="{StaticResource C_Dim}"/>
            <SolidColorBrush x:Key="B_Sel"     Color="{StaticResource C_Sel}"/>

            <!-- ── Base text style ──────────────────────────────────────── -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize"   Value="13"/>
            </Style>

            <!-- ── Accent button ────────────────────────────────────────── -->
            <Style x:Key="AccentBtn" TargetType="Button">
                <Setter Property="Height"            Value="28"/>
                <Setter Property="Padding"           Value="10,0"/>
                <Setter Property="FontFamily"        Value="Segoe UI"/>
                <Setter Property="FontSize"          Value="12"/>
                <Setter Property="FontWeight"        Value="SemiBold"/>
                <Setter Property="Background"        Value="{StaticResource B_Panel2}"/>
                <Setter Property="BorderThickness"   Value="1"/>
                <Setter Property="Cursor"            Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Dark TextBox ─────────────────────────────────────────── -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background"   Value="{StaticResource B_Panel2}"/>
                <Setter Property="Foreground"   Value="{StaticResource B_Text}"/>
                <Setter Property="BorderBrush"  Value="{StaticResource B_Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush"   Value="{StaticResource B_Text}"/>
                <Setter Property="FontFamily"   Value="Segoe UI"/>
                <Setter Property="FontSize"     Value="13"/>
                <Setter Property="Padding"      Value="6,4"/>
            </Style>

            <!-- ── Dark ComboBox ────────────────────────────────────────── -->
            <Style x:Key="DarkCombo" TargetType="ComboBox">
                <Setter Property="Background"  Value="{StaticResource B_Panel2}"/>
                <Setter Property="Foreground"  Value="{StaticResource B_Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource B_Border}"/>
                <Setter Property="FontFamily"  Value="Segoe UI"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Height"      Value="28"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="3">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            Margin="8,0,26,0"
                                            VerticalAlignment="Center"/>
                                        <TextBlock Text="▾" HorizontalAlignment="Right"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource B_Dim}"/>
                                    </Grid>
                                </Border>
                                <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Placement="Bottom">
                                    <Border Background="{StaticResource B_Panel2}"
                                            BorderBrush="{StaticResource B_Border}"
                                            BorderThickness="1" CornerRadius="3">
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{StaticResource B_Panel2}"/>
                        <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
                        <Setter Property="Padding"    Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource B_Sel}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource B_Sel}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Style.Resources>
            </Style>

            <!-- ── Dark ScrollBar ───────────────────────────────────────── -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{StaticResource B_Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource B_Border}"/>
            </Style>

            <!-- ── ListView / GridView dark style ──────────────────────── -->
            <Style x:Key="DarkListView" TargetType="ListView">
                <Setter Property="Background"         Value="{StaticResource B_BG}"/>
                <Setter Property="Foreground"         Value="{StaticResource B_Text}"/>
                <Setter Property="BorderBrush"        Value="{StaticResource B_Border}"/>
                <Setter Property="BorderThickness"    Value="0"/>
                <Setter Property="FontFamily"         Value="Consolas"/>
                <Setter Property="FontSize"           Value="12"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            </Style>

            <Style x:Key="DarkGridViewColumnHeader" TargetType="GridViewColumnHeader">
                <Setter Property="Background"   Value="{StaticResource B_Panel2}"/>
                <Setter Property="Foreground"   Value="{StaticResource B_Accent2}"/>
                <Setter Property="BorderBrush"  Value="{StaticResource B_Border}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="FontFamily"   Value="Segoe UI"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="FontSize"     Value="12"/>
                <Setter Property="Height"       Value="28"/>
                <Setter Property="Padding"      Value="8,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource B_Sel}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DarkListViewItem" TargetType="ListViewItem">
                <Setter Property="Height"           Value="26"/>
                <Setter Property="Padding"          Value="4,0"/>
                <Setter Property="Margin"           Value="0"/>
                <Setter Property="Background"       Value="{StaticResource B_BG}"/>
                <Setter Property="Foreground"       Value="{StaticResource B_Text}"/>
                <Setter Property="BorderThickness"  Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="Center"
                                                      Columns="{Binding Path=View.Columns,
                                                          RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource B_Sel}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="#1A58A6FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Dark NumericUpDown (using TextBox+Buttons) ───────────── -->
            <Style x:Key="DarkNumericBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                <Setter Property="Width"  Value="110"/>
                <Setter Property="Height" Value="26"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
